# ------------------------------------------------------------------
# Local AI Video Explainer - environment configuration template
# Copy this file to ".env" (same folder) and adjust values as needed.
# Never commit a real ".env" file. There are no secrets in the app.
# ------------------------------------------------------------------

# Application
APP_NAME=Local AI Video Explainer
ENVIRONMENT=development
APP_VERSION=0.3.0

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend (used for CORS + docs)
FRONTEND_URL=http://127.0.0.1:5173
# Comma-separated JSON list is also accepted: CORS_ORIGINS=["http://127.0.0.1:5173"]

# Upload limits (Phase 2)
# Maximum single upload size in megabytes.
MAX_UPLOAD_SIZE_MB=4096
# Bytes read per streaming chunk (1 MiB default). Lower = less RAM, more IO.
# UPLOAD_CHUNK_SIZE=1048576
# Accepted video containers (JSON list; values may omit the leading dot).
# ALLOWED_VIDEO_EXTENSIONS=["mp4","mkv","avi","mov","webm","m4v","mpeg","mpg","ts"]
# Timeout for a single FFprobe validation run, in seconds.
FFPROBE_TIMEOUT_SECONDS=60

# Processing
# One heavy video-processing job at a time (8 GB RAM target machine).
PROCESSING_CONCURRENCY=1

# Phase 3 - preprocessing / analysis assets
# Width cap of the analysis copy (height follows aspect, even pixels).
# Kept modest: vision/OCR stages read this copy; CPU-only 8 GB machine.
ANALYSIS_WIDTH=640
# Constant frame rate of the analysis copy (fps filter normalizes to it).
ANALYSIS_FPS=5
# x264 preset + CRF for the analysis copy (quality is not the goal here).
ANALYSIS_ENCODER_PRESET=veryfast
ANALYSIS_CRF=30
# Width cap of the poster JPEG thumbnail.
THUMBNAIL_WIDTH=320
# Audio extraction for later speech-to-text: 16 kHz mono PCM WAV.
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
# Upper bound for one FFmpeg preprocessing step, in seconds.
PREPROCESS_TIMEOUT_SECONDS=600

# FFmpeg / ffprobe
# Leave empty to auto-discover on PATH. Set an absolute path only if
# FFmpeg is installed somewhere that is not on PATH, e.g.:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
FFMPEG_PATH=
FFPROBE_PATH=

# Storage directories (relative paths resolve under the project root).
# DATA_DIR=data
# UPLOAD_DIR=data/uploads
# TEMP_DIR=data/temp
# OUTPUT_DIR=data/outputs
# CACHE_DIR=data/cache
# PROJECTS_DIR=data/projects
# MODELS_DIR=models
# LOGS_DIR=logs
# DATABASE_PATH=data/explainer.db

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
