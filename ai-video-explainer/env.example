# ------------------------------------------------------------------
# Local AI Video Explainer - environment configuration template
# Copy this file to ".env" (same folder) and adjust values as needed.
# Never commit a real ".env" file. There are no secrets in the app.
# ------------------------------------------------------------------

# Application
APP_NAME=Local AI Video Explainer
ENVIRONMENT=development
APP_VERSION=0.7.0

# Backend server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend (used for CORS + docs)
FRONTEND_URL=http://127.0.0.1:5173
# Comma-separated JSON list is also accepted: CORS_ORIGINS=["http://127.0.0.1:5173"]

# Upload limits (Phase 2)
# Maximum single upload size in megabytes.
MAX_UPLOAD_SIZE_MB=4096
# Bytes read per streaming chunk (1 MiB default). Lower = less RAM, more IO.
# UPLOAD_CHUNK_SIZE=1048576
# Accepted video containers (JSON list; values may omit the leading dot).
# ALLOWED_VIDEO_EXTENSIONS=["mp4","mkv","avi","mov","webm","m4v","mpeg","mpg","ts"]
# Timeout for a single FFprobe validation run, in seconds.
FFPROBE_TIMEOUT_SECONDS=60

# Processing
# One heavy video-processing job at a time (8 GB RAM target machine).
PROCESSING_CONCURRENCY=1

# Phase 3 - preprocessing / analysis assets
# Width cap of the analysis copy (height follows aspect, even pixels).
# Kept modest: vision/OCR stages read this copy; CPU-only 8 GB machine.
ANALYSIS_WIDTH=640
# Constant frame rate of the analysis copy (fps filter normalizes to it).
ANALYSIS_FPS=5
# x264 preset + CRF for the analysis copy (quality is not the goal here).
ANALYSIS_ENCODER_PRESET=veryfast
ANALYSIS_CRF=30
# Width cap of the poster JPEG thumbnail.
THUMBNAIL_WIDTH=320
# Audio extraction for later speech-to-text: 16 kHz mono PCM WAV.
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
# Upper bound for one FFmpeg preprocessing step, in seconds.
PREPROCESS_TIMEOUT_SECONDS=600

# Phase 4 - local analysis
# Upper bound for one analysis stage (scene pass, whisper, OCR, visual).
ANALYSIS_TIMEOUT_SECONDS=1800

# Speech-to-text: faster-whisper, CPU-only, lazy-loaded when an analysis
# job starts (never at startup) and released afterwards. The model is
# downloaded ONCE explicitly (scripts\download_whisper_model.bat) - the app
# never downloads it silently. No API key needed.
WHISPER_MODEL=tiny
#   ^ tiny | base (CPU-friendly sizes only). IMPORTANT: keep this value line
#     free of trailing comments - the Windows setup scripts read it with a
#     plain text parser (findstr) and would otherwise treat the comment text
#     as part of the model name.
WHISPER_DEVICE=cpu          # cpu | cuda | auto (cuda is optional)
WHISPER_COMPUTE_TYPE=int8   # int8 is the RAM-friendly default
# preferred: hint with the project language but keep auto-detection;
# auto: pure auto-detection; forced: force the project language.
WHISPER_LANGUAGE_MODE=preferred

# Scene detection (FFmpeg scene filter - deterministic, no extra package)
SCENE_THRESHOLD=0.3         # 0..1: lower = more scene changes detected
MIN_SCENE_DURATION_SECONDS=2.0
MAX_SCENES=500

# OCR (Tesseract). Absent binary = OCR skipped gracefully, never fake.
OCR_ENABLED=true
# Cap on how many representative frames are OCR'd (scene order).
OCR_FRAME_LIMIT=60
# Optional: absolute path when Tesseract is not on PATH, e.g.
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=

# Visual frame analysis (deterministic PIL metadata; a local vision model
# can be plugged in later without touching the pipeline).
VISUAL_ANALYSIS_ENABLED=true

# Phase 5 - local LLM (story understanding + script generation)
# The app shells out to the llama.cpp CLI (llama-cli) per generation: no
# Python binding, no always-loaded model, one model in RAM at a time.
# The GGUF model is downloaded ONCE explicitly (scripts\download_llm_model.bat)
# - the app never downloads models silently.
LLM_PROVIDER=llama_cpp      # llama_cpp | none (none disables generation)
# Leave empty to auto-discover "llama-cli" on PATH, or set an absolute
# path to the binary, e.g.:
# LLAMA_CPP_PATH=C:\llama.cpp\build\bin\Release\llama-cli.exe
LLAMA_CPP_PATH=
# Leave empty to auto-discover a single *.gguf inside the models/ folder,
# or set an absolute path to a quantized GGUF, e.g.:
# LLAMA_MODEL_PATH=C:\models\qwen2.5-1.5b-instruct-q4_k_m.gguf
LLAMA_MODEL_PATH=
# CPU threads / context / max tokens for the small 8 GB machine.
LLAMA_THREADS=4
LLAMA_CONTEXT_SIZE=2048
LLAMA_MAX_TOKENS=1024
# Hard timeout for one generation, in seconds.
LLAMA_TIMEOUT_SECONDS=300
# Low temperature keeps narration grounded and repeatable.
LLM_TEMPERATURE=0.2
LLM_SEED=42

# Story understanding: hierarchical batches for long videos.
STORY_BATCH_SCENES=15
# Per-scene transcript/OCR excerpt cap in characters (bounded prompts).
STORY_MAX_EXCERPT_CHARS=240
# Bump these when prompt templates change; they are part of the generation
# fingerprint, so old results are regenerated automatically.
STORY_PROMPT_VERSION=1.0
SCRIPT_PROMPT_VERSION=1.0
PLANNER_VERSION=1.0

# Narration pacing: words per minute used for duration estimates and the
# word targets below (2 min: 250-300, 3 min: 375-450, 4 min: 500-600).
NARRATION_WPM=145
# SCRIPT_WORD_TARGETS={"120":[250,300],"180":[375,450],"240":[500,600]}

# Scene importance weights (additive part must sum to 0.95; the redundancy
# adjustment is the remaining 5% and applies as a multiplicative penalty).
# IMPORTANCE_WEIGHT_INFORMATION_DENSITY=0.25
# IMPORTANCE_WEIGHT_SPEECH_DENSITY=0.15
# IMPORTANCE_WEIGHT_SEMANTIC=0.25
# IMPORTANCE_WEIGHT_TURNING_POINT=0.15
# IMPORTANCE_WEIGHT_CONTINUITY=0.10
# IMPORTANCE_WEIGHT_OCR=0.05
# IMPORTANCE_REDUNDANCY_PENALTY=0.05

# Script budget clamps (per-scene narration words).
# MIN_WORDS_PER_SCENE=15
# MAX_WORDS_PER_SCENE=110
# MIN_SCENES_PER_SCRIPT=3
# MAX_SELECTED_SCENES=24

# Phase 6 - local TTS narration (Piper) + subtitles synced to real audio
# The app shells out to the Piper CLI per segment: no Python binding, no
# always-loaded model, one voice in RAM at a time, fully offline.
# Voices are downloaded ONCE explicitly (scripts/setup_piper_voices.bat or
# _unix.sh) - the app never downloads voices silently.
TTS_PROVIDER=piper         # piper | none (none disables narration)
# Leave empty to auto-discover "piper" on PATH, or set an absolute path to
# the binary, e.g.:
# TTS_EXECUTABLE_PATH=C:\piper\piper.exe
TTS_EXECUTABLE_PATH=
# Per-language Piper voice (.onnx; a sibling .onnx.json config is expected
# next to it). Leave empty to auto-discover models/voices/<lang>/*.onnx.
# TTS_VOICE_EN=C:\piper\voices\en_US-lessac-medium.onnx
# TTS_VOICE_HI=C:\piper\voices\hi_IN-sanman-neural.onnx
# TTS_VOICE_BN=C:\piper\voices\bn_IN-tanmay-medium.onnx
TTS_VOICE_EN=
TTS_VOICE_HI=
TTS_VOICE_BN=
# Narration audio format: mono lossless WAV intermediate at this rate.
TTS_SAMPLE_RATE=22050
TTS_CHANNELS=1
# Hard timeout for one segment synthesis, in seconds.
TTS_TIMEOUT_SECONDS=180
# Optional speaker id for multi-speaker Piper voices (empty = default).
TTS_SPEAKER=
# Slight speed/slowdown of the voice (1.0 = natural).
TTS_LENGTH_SCALE=1.0
# Pauses inserted between narration segments (ms) - small gaps keep speech
# natural; the timeline + subtitles are always timed to the real audio.
TTS_GAP_MS_WITHIN_SECTION=140
TTS_GAP_MS_BETWEEN_SECTIONS=400
TTS_LEAD_IN_MS=300

# Subtitle (SRT/VTT) readability caps.
# SUBTITLE_MAX_CHARS_PER_LINE=42
# SUBTITLE_MAX_CHARS_PER_CAPTION=84

# Phase 7 - final video render (mixing + subtitle burn-in + final MP4)
# Runs locally through FFmpeg only: the selected scene ranges are cut from
# the original upload (never a full re-encode of the source), the original
# audio is ducked under the narration, and synchronized subtitles are burned
# into the frames. CPU-first defaults for the 8 GB target machine.

# Final video size cap - scales down only (even pixels). 1280x720 keeps the
# CPU encode usable on a Ryzen 3 3200G; raise for higher-resolution output.
OUTPUT_MAX_WIDTH=1280
OUTPUT_MAX_HEIGHT=720
# Final frame rate: a number, or 'source' to keep the source frame rate.
OUTPUT_FPS=30
# CPU-first final encode (H.264). preset/CRF trade encode time vs quality.
VIDEO_CODEC=libx264
VIDEO_PRESET=veryfast
VIDEO_CRF=23

# Mixing: original audio from the selected ranges, ducked under narration.
# Set ORIGINAL_AUDIO_ENABLED=false to output narration-only audio.
ORIGINAL_AUDIO_ENABLED=true
ORIGINAL_AUDIO_VOLUME=0.18
NARRATION_AUDIO_VOLUME=1.0
# Narration-driven sidechain ducking of the original audio.
AUDIO_DUCKING_ENABLED=true
AUDIO_DUCKING_THRESHOLD=0.02
AUDIO_DUCKING_RATIO=6
AUDIO_DUCKING_ATTACK_MS=15
AUDIO_DUCKING_RELEASE_MS=350

# Subtitle burn-in (FFmpeg/libass). English renders with the default sans
# font; Hindi/Bengali glyphs need a Unicode font configured or the render
# refuses with setup instructions (never tofu boxes). Windows example:
SUBTITLE_BURN_ENABLED=true
# SUBTITLE_FONT_PATH=C:\Windows\Fonts\Nirmala.ttc
# SUBTITLE_FONT_NAME=Noto Sans Devanagari
SUBTITLE_FONT_PATH=
SUBTITLE_FONT_NAME=
SUBTITLE_FONT_SIZE=20
SUBTITLE_MARGIN_V=24

# Output pacing: hold the last scene for RENDER_TAIL_MS after the narration
# ends; narration gaps larger than RENDER_HOLD_GAP_MAX_MS hold the previous
# scene anyway (never black frames or dead air).
RENDER_TAIL_MS=1200
RENDER_HOLD_GAP_MAX_MS=1500
# Upper bound for ONE render FFmpeg pass (long clips on a slow CPU).
RENDER_TIMEOUT_SECONDS=3600

# FFmpeg / ffprobe
# Leave empty to auto-discover on PATH. Set an absolute path only if
# FFmpeg is installed somewhere that is not on PATH, e.g.:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
FFMPEG_PATH=
FFPROBE_PATH=

# Storage directories (relative paths resolve under the project root).
# DATA_DIR=data
# UPLOAD_DIR=data/uploads
# TEMP_DIR=data/temp
# OUTPUT_DIR=data/outputs
# CACHE_DIR=data/cache
# PROJECTS_DIR=data/projects
# MODELS_DIR=models
# LOGS_DIR=logs
# DATABASE_PATH=data/explainer.db

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
